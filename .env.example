# Umgebungsvariablen einer Kundeninstanz – VORLAGE mit Platzhaltern.
# Lokal: kopieren nach .env im Repo-Ordner (wird von git ignoriert).
# Server: liegt je Kunde neben pb_data, Rechte 600 (wird ab Phase 7 von deploy/neuer-kunde.sh angelegt).
# Niemals echte Werte in diese Datei schreiben – sie liegt im Repo.

# --- Instanz ---------------------------------------------------------------
# Kundenordner unter kunden/ (lokal: Standard für "npm run dev")
NF_KUNDE=_beispiel
# Port auf 127.0.0.1, pro Kunde eindeutig
PB_PORT=8090

# --- Admin-Zugang (Superuser) ------------------------------------------------
# Optional. Wenn beide gesetzt sind, legt "npm run dev" den Zugang an bzw.
# setzt das Passwort neu (mind. 8 Zeichen). Ohne Angabe zeigt der erste Start
# einen Einrichtungslink. Zwei-Faktor wird in Phase 2/7 eingerichtet.
PB_SUPERUSER_EMAIL=
PB_SUPERUSER_PASSWORD=

# --- Automationen -------------------------------------------------------------
# Basis-Adresse der Webhooks für diesen Kunden. Angehängt werden:
#   /neue-buchung   /verschoben-abgesagt   /status
# Leer lassen = keine Benachrichtigung (lokal ohne Automationen).
NF_WEBHOOK_URL=http://127.0.0.1:5678/webhook/<kunde>
# Wird als Header "X-NF-Secret" mitgeschickt; die Automationen prüfen ihn.
NF_WEBHOOK_SECRET=

# Öffentliche Adresse für Links in Mails (Standard: https://<domain aus kunde.json>;
# lokal setzt "npm run dev" automatisch die lokale Adresse).
NF_OEFFENTLICHE_URL=

# --- Zugangsdaten für die Automationen ------------------------------------------
# Nur für "npm run n8n": daraus entstehen die Credentials zum Import in n8n.
# Die erzeugte credentials.json enthält Secrets – nach dem Import löschen.
# Benötigt wird der Versandweg aus nachrichten.json (adapter smtp ODER graph).

# SMTP-Zugang des Kunden
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# true = TLS ab Verbindungsbeginn (Port 465); false = STARTTLS (Port 587)
SMTP_SECURE=false

# Microsoft 365 (App-Freigabe des Kunden: Mail.Send als Anwendungsberechtigung)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# Telegram-Benachrichtigung an NovaFlow bei Versandfehlern (ohne personenbezogene Daten)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
