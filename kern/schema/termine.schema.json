{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "termine.schema.json",
  "title": "termine.json – Termintypen, Regeln, Ressourcen, Sperrtage (Startwerte)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "zeitraum",
    "termintypen",
    "ressourcen",
    "sperrtage"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "zeitraum": {
      "description": "Zeitraum für normale Buchungen",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "buchbar_ab",
        "buchbar_bis"
      ],
      "properties": {
        "buchbar_ab": {
          "$ref": "common.schema.json#/$defs/datum"
        },
        "buchbar_bis": {
          "$ref": "common.schema.json#/$defs/datum"
        }
      }
    },
    "max_pro_woche": {
      "description": "Optional: max. Buchungen pro Kalenderwoche (alle Termintypen)",
      "type": "integer",
      "minimum": 1
    },
    "folgetermin": {
      "description": "Nur nötig, wenn Modul folgetermin aktiv ist",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "termintyp",
        "ab",
        "bis"
      ],
      "properties": {
        "termintyp": {
          "$ref": "common.schema.json#/$defs/code"
        },
        "ab": {
          "$ref": "common.schema.json#/$defs/datum"
        },
        "bis": {
          "$ref": "common.schema.json#/$defs/datum"
        }
      }
    },
    "termintypen": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "name",
          "dauer_minuten",
          "regeln"
        ],
        "properties": {
          "code": {
            "$ref": "common.schema.json#/$defs/code"
          },
          "name": {
            "$ref": "common.schema.json#/$defs/textKurz"
          },
          "dauer_minuten": {
            "type": "integer",
            "minimum": 5,
            "maximum": 1440
          },
          "regeln": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "wochentage",
                "von",
                "bis",
                "takt_minuten",
                "max_pro_slot"
              ],
              "properties": {
                "wochentage": {
                  "description": "1 = Montag … 7 = Sonntag",
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 7
                  }
                },
                "von": {
                  "description": "Erster möglicher Terminbeginn",
                  "$ref": "common.schema.json#/$defs/uhrzeit"
                },
                "bis": {
                  "description": "Ende des Zeitfensters (letzter Beginn = bis − Dauer)",
                  "$ref": "common.schema.json#/$defs/uhrzeit"
                },
                "takt_minuten": {
                  "type": "integer",
                  "minimum": 5,
                  "maximum": 1440
                },
                "max_pro_slot": {
                  "type": "integer",
                  "minimum": 1
                },
                "max_pro_tag": {
                  "type": "integer",
                  "minimum": 1
                },
                "gueltig_von": {
                  "$ref": "common.schema.json#/$defs/datum"
                },
                "gueltig_bis": {
                  "$ref": "common.schema.json#/$defs/datum"
                }
              }
            }
          }
        }
      }
    },
    "ressourcen": {
      "description": "Begrenzte Ressourcen, die eine Buchung belegt (Anzahl = Kapazität)",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "name",
          "kapazitaet"
        ],
        "properties": {
          "code": {
            "$ref": "common.schema.json#/$defs/code"
          },
          "name": {
            "$ref": "common.schema.json#/$defs/textKurz"
          },
          "kapazitaet": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "sperrtage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "datum"
        ],
        "properties": {
          "datum": {
            "$ref": "common.schema.json#/$defs/datum"
          },
          "grund": {
            "$ref": "common.schema.json#/$defs/textKurz"
          }
        }
      }
    }
  }
}
