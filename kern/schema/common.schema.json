{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "title": "Gemeinsame Bausteine der Kundenkonfiguration",
  "$defs": {
    "code": {
      "description": "Technischer Schlüssel: Kleinbuchstaben, Ziffern, Unterstrich; beginnt mit Buchstabe.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,39}$"
    },
    "textKurz": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "textLang": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "datum": {
      "description": "Datum im Format JJJJ-MM-TT",
      "type": "string",
      "format": "date"
    },
    "uhrzeit": {
      "description": "Uhrzeit im Format HH:MM (24 h)",
      "type": "string",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
    },
    "email": {
      "type": "string",
      "format": "email",
      "maxLength": 254
    },
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "farbe": {
      "description": "Farbe als Hex-Wert #RRGGBB",
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "dateiname": {
      "description": "Dateiname ohne Pfad",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"
    },
    "duSie": {
      "description": "Text in beiden Ansprache-Varianten",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "du",
        "sie"
      ],
      "properties": {
        "du": {
          "$ref": "#/$defs/textLang"
        },
        "sie": {
          "$ref": "#/$defs/textLang"
        }
      }
    }
  }
}
