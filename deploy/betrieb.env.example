# Server-wide operations settings – VORLAGE. On the server: /etc/novaflow/betrieb.env (root, 600),
# created by deploy/server-einrichten.sh. Never put real values into this file.

# --- Backups (restic) ---------------------------------------------------------------
# Repository on NovaFlow's own storage at Hostinger, e.g. a local path or sftp:user@host:/pfad
RESTIC_REPOSITORY=/var/backups/novaflow
# File with the repository password (generated on setup). ALSO store it in the password
# manager: without it, no backup can ever be read again.
RESTIC_PASSWORD_FILE=/etc/novaflow/restic-passwort

# --- Automations ----------------------------------------------------------------------
# Webhook base of the automation server as seen from this server; neuer-kunde.sh appends /<kennung>
NF_N8N_WEBHOOK_BASIS=http://127.0.0.1:5678/webhook

# --- Admin access ---------------------------------------------------------------------
# Optional: neuer-kunde.sh creates an admin login with this address in every new instance
# (second factor: code by mail through the instance's mail sending)
NF_ADMIN_EMAIL=

# --- Alerts (without personal data) -----------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
