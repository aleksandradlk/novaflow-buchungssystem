# Site block of one instance – generated by deploy/neuer-kunde.sh from deploy/caddy/kunde.caddy.vorlage.
# Do not edit on the server: changes are overwritten by the next neuer-kunde.sh / ausrollen.sh.
__DOMAIN__ {
	encode zstd gzip

	header {
		-Server
		-Via
		-X-Powered-By
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; frame-src 'none'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
	}

	# admin UI and everything only the automations or an administrator may call:
	# reachable on the server itself (127.0.0.1:__PORT__) or through an SSH tunnel only
	@gesperrt path /_ /_/* /api/nf-intern/* /api/collections/_superusers/* /api/settings /api/settings/* /api/backups /api/backups/* /api/logs /api/logs/* /api/crons /api/crons/* /api/batch /api/realtime /api/health
	respond @gesperrt 404

	# same limit as the booking route (photos, see kern/pb_hooks/nf.pb.js)
	request_body {
		max_size 110MB
	}

	reverse_proxy 127.0.0.1:__PORT__ {
		# the instance trusts only this header for the client address (rate limits)
		header_up X-Real-IP {remote_host}
		header_down -Server
	}
}

# explicit http → https redirect (the automatic one would send a "Server" header)
http://__DOMAIN__ {
	header {
		-Server
		Referrer-Policy "no-referrer"
	}
	redir https://{host}{uri} 308
}
